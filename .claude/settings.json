{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run tokens:contrast)",
      "Bash(npm run preview)",
      "Bash(npx vite preview:*)",
      "Bash(node scripts/*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(vercel)",
      "Bash(vercel ls:*)",
      "Bash(vercel inspect:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel domains:*)",
      "Bash(vercel env:*)"
    ],
    "deny": [
      "Edit(legacy/**)",
      "Write(legacy/**)",
      "Read(.env*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
