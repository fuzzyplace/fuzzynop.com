{
  "$schema": "Canonical design tokens for fuzzynop.com v2. M3 role naming. Edit here first, then mirror to src/styles/tokens.css.",
  "name": "FZNP / Cyborg Dark",
  "version": "2.2.0",
  "color": {
    "ref": {
      "black": "#000000",
      "gray-990": "#0A0A0A",
      "gray-980": "#0F0F0F",
      "gray-960": "#141414",
      "gray-940": "#1A1A1A",
      "gray-900": "#222221",
      "gray-800": "#333331",
      "gray-700": "#4A4A47",
      "gray-600": "#6E6E6A",
      "gray-500": "#8C8C88",
      "gray-400": "#A6A6A2",
      "gray-300": "#C9C9C4",
      "gray-200": "#E6E6E1",
      "gray-100": "#F5F5F0",
      "white": "#FFFFFF",
      "cone": "#FF6A13",
      "cone-dim": "#C24A00",
      "signal-red": "#FF4D6D",
      "ink": "#050505",
      "paper": "#EDEDE8",
      "fog-light": "#C9C9C3",
      "fog-mid": "#7A7A75",
      "rim": "#3C3C39",
      "silhouette-far": "#2C2C2A",
      "silhouette-mid": "#111110"
    },
    "sys": {
      "background": "{ref.gray-990}",
      "on-background": "{ref.gray-100}",
      "surface": "{ref.gray-990}",
      "surface-dim": "{ref.black}",
      "surface-bright": "{ref.gray-800}",
      "surface-container-lowest": "{ref.black}",
      "surface-container-low": "{ref.gray-980}",
      "surface-container": "{ref.gray-960}",
      "surface-container-high": "{ref.gray-940}",
      "surface-container-highest": "{ref.gray-900}",
      "on-surface": "{ref.gray-100}",
      "on-surface-variant": "{ref.gray-400}",
      "outline": "{ref.gray-600}",
      "outline-variant": "{ref.gray-900}",
      "primary": "{ref.gray-100}",
      "on-primary": "{ref.gray-990}",
      "secondary": "{ref.gray-500}",
      "on-secondary": "{ref.gray-990}",
      "secondary-container": "{ref.gray-800}",
      "on-secondary-container": "{ref.gray-200}",
      "accent": "{ref.cone}",
      "inverse-surface": "{ref.gray-100}",
      "inverse-on-surface": "{ref.gray-990}",
      "error": "{ref.signal-red}",
      "on-error": "{ref.black}",
      "scrim": "rgba(0,0,0,.72)",
      "ink": "{ref.ink}",
      "paper": "{ref.paper}",
      "on-paper": "{ref.ink}",
      "on-paper-variant": "{ref.gray-700}",
      "rim": "{ref.rim}",
      "silhouette-far": "{ref.silhouette-far}",
      "silhouette-mid": "{ref.silhouette-mid}"
    },
    "state-layer-opacity": {
      "hover": 0.08,
      "focus": 0.12,
      "pressed": 0.12,
      "dragged": 0.16
    },
    "accent_rules": "Orange (accent) is a highlight only: printer nozzle hot-tip + glow while printing, the 72px print-line segment, focus ring, 1px link-hover underline. Never a fill behind text, never a button, never body text."
  },
  "typography": {
    "family": {
      "display": "'Instrument Serif', 'Iowan Old Style', Georgia, serif",
      "sans": "'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
    },
    "roles_comment": "M3 type scale. size/line-height in rem. display+headline = organic serif; title/body = machine sans; label = mono telemetry.",
    "scale": {
      "display-large": {
        "family": "display",
        "size": "clamp(3.5rem, 9vw, 7.5rem)",
        "line": "0.95",
        "weight": 400,
        "tracking": "-0.02em"
      },
      "display-medium": {
        "family": "display",
        "size": "clamp(2.75rem, 6vw, 4.5rem)",
        "line": "1.0",
        "weight": 400,
        "tracking": "-0.015em"
      },
      "display-small": {
        "family": "display",
        "size": "clamp(2.25rem, 4.5vw, 3.25rem)",
        "line": "1.05",
        "weight": 400,
        "tracking": "-0.01em"
      },
      "headline-large": {
        "family": "display",
        "size": "2rem",
        "line": "1.15",
        "weight": 400,
        "tracking": "0"
      },
      "headline-medium": {
        "family": "display",
        "size": "1.75rem",
        "line": "1.2",
        "weight": 400,
        "tracking": "0"
      },
      "headline-small": {
        "family": "sans",
        "size": "1.5rem",
        "line": "1.25",
        "weight": 500,
        "tracking": "-0.01em"
      },
      "title-large": {
        "family": "sans",
        "size": "1.375rem",
        "line": "1.3",
        "weight": 500,
        "tracking": "-0.005em"
      },
      "title-medium": {
        "family": "sans",
        "size": "1rem",
        "line": "1.5",
        "weight": 500,
        "tracking": "0.01em"
      },
      "title-small": {
        "family": "sans",
        "size": "0.875rem",
        "line": "1.43",
        "weight": 500,
        "tracking": "0.01em"
      },
      "body-large": {
        "family": "sans",
        "size": "1.125rem",
        "line": "1.6",
        "weight": 400,
        "tracking": "0"
      },
      "body-medium": {
        "family": "sans",
        "size": "1rem",
        "line": "1.6",
        "weight": 400,
        "tracking": "0"
      },
      "body-small": {
        "family": "sans",
        "size": "0.875rem",
        "line": "1.5",
        "weight": 400,
        "tracking": "0.01em"
      },
      "label-large": {
        "family": "mono",
        "size": "0.875rem",
        "line": "1.43",
        "weight": 500,
        "tracking": "0.04em",
        "case": "uppercase"
      },
      "label-medium": {
        "family": "mono",
        "size": "0.75rem",
        "line": "1.33",
        "weight": 500,
        "tracking": "0.08em",
        "case": "uppercase"
      },
      "label-small": {
        "family": "mono",
        "size": "0.6875rem",
        "line": "1.45",
        "weight": 500,
        "tracking": "0.1em",
        "case": "uppercase"
      }
    }
  },
  "shape": {
    "comment": "Mostly sharp (machine). 'full' reserved for organic accents: pills, avatars, the eye.",
    "corner-none": "0px",
    "corner-extra-small": "2px",
    "corner-small": "4px",
    "corner-medium": "8px",
    "corner-large": "16px",
    "corner-extra-large": "28px",
    "corner-full": "9999px"
  },
  "space": {
    "base": "4px",
    "scale": [
      0,
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96,
      128,
      192
    ]
  },
  "layout": {
    "max-width": "1200px",
    "gutter-mobile": "16px",
    "gutter-desktop": "32px",
    "columns": 12,
    "breakpoints": {
      "compact": "0",
      "medium": "600px",
      "expanded": "840px",
      "large": "1200px",
      "extra-large": "1600px"
    }
  },
  "elevation": {
    "comment": "Dark UI: elevation = lighter surface-container tier + hairline, not shadow.",
    "level0": "surface",
    "level1": "surface-container-low",
    "level2": "surface-container",
    "level3": "surface-container-high",
    "level4": "surface-container-highest"
  },
  "motion": {
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "standard-decelerate": "cubic-bezier(0, 0, 0, 1)",
      "standard-accelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized-decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "emphasized-accelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    },
    "duration": {
      "short1": "50ms",
      "short2": "100ms",
      "short3": "150ms",
      "short4": "200ms",
      "medium1": "250ms",
      "medium2": "300ms",
      "medium3": "350ms",
      "medium4": "400ms",
      "long1": "450ms",
      "long2": "500ms",
      "long3": "550ms",
      "long4": "600ms",
      "extra-long1": "700ms",
      "extra-long4": "1000ms"
    }
  },
  "art": {
    "style": "Limbo-like ink + paper cut-out silhouettes on fog; biomechanical spider-leg arms with machined hex joints; ink splatter; hexagon lattice.",
    "depth": {
      "far": "silhouette-far + 3px blur",
      "mid": "silhouette-mid + #ink filter",
      "near": "ink + #ink-heavy filter"
    },
    "filters": [
      "#ink",
      "#ink-heavy",
      "#far",
      "#glow"
    ]
  }
}
